{
  "manifest_version": 3,
  "name": "McGill Lecture to MP3",
  "version": "0.1.0",
  "description": "Detects McGill lecture recordings you're watching and saves the audio as an MP3 in a folder you choose.",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["webRequest", "storage", "offscreen"],
  "host_permissions": ["https://*.mcgill.ca/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Lecture to MP3",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
